# artefatos de build (um diretório por configuração; ver Makefile)
build/
build-*/
*.o
*.obj
*.gerado.c
*.lib
*.exe
*.pdb
*.ilk
__pycache__/
.venv/
node_modules/

# Documentação: fontes versionadas em website/, saída regenerada pelo Python.
website/.docusaurus/
website/build/
website/docs/
website/static/api/

