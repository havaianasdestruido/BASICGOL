
#include <basicgol.h>

INICIO
    VETOR(INTEIRO, v, 5);
    INTEIRO i = 0;
    INTEIRO soma = 0;

    PARA (i, 0, 4) {
        v[i] = i * i;
    }
    PARA (i, 0, 4) {
        soma = soma + v[i];
    }

    ESCREVAL(v[0]);     // 0
    ESCREVAL(v[4]);     // 16
    ESCREVAL(soma);     // 0+1+4+9+16 = 30
FIM
